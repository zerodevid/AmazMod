<?xml version="1.0" encoding="utf-8"?><!--
    Springboard page showing the same navigation state as NavigationActivity, so the user can swipe
    to it instead of relying on the screen popping up by itself.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/navigation_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    tools:ignore="SpUsage, ContentDescription">

    <LinearLayout
        android:id="@+id/navigation_widget_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp">

        <TextView
            android:id="@+id/navigation_widget_clock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:letterSpacing="0.08"
            android:maxLines="1"
            android:textColor="@color/colorGrey"
            android:textSize="13sp"
            tools:text="05:52" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/navigation_widget_icon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="10dp"
                android:scaleType="fitCenter"
                android:visibility="gone"
                tools:src="@drawable/ic_navigation_white_24"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/navigation_widget_distance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/colorBlue"
                android:textSize="30sp"
                android:textStyle="bold"
                tools:text="450 m" />

        </LinearLayout>

        <TextView
            android:id="@+id/navigation_widget_road"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:textColor="@color/white"
            android:textSize="17sp"
            tools:text="Jl. Jenderal Sudirman" />

        <com.amazmod.service.ui.RouteProgressView
            android:id="@+id/navigation_widget_progress"
            android:layout_width="match_parent"
            android:layout_height="7dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="6dp"
            android:visibility="gone"
            tools:visibility="visible" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/navigation_widget_remaining_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="12 km" />

                <TextView
                    android:id="@+id/navigation_widget_remaining_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textAllCaps="true"
                    android:textColor="@color/colorGrey"
                    android:textSize="9sp"
                    tools:text="@string/navigation_label_remaining" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/navigation_widget_duration_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="23 mnt" />

                <TextView
                    android:id="@+id/navigation_widget_duration_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textAllCaps="true"
                    android:textColor="@color/colorGrey"
                    android:textSize="9sp"
                    tools:text="@string/navigation_label_duration" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/navigation_widget_arrival_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="20.45" />

                <TextView
                    android:id="@+id/navigation_widget_arrival_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textAllCaps="true"
                    android:textColor="@color/colorGrey"
                    android:textSize="9sp"
                    tools:text="@string/navigation_label_arrival" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- Compass, matching the full screen: overlaid so it costs no layout height -->
    <ImageView
        android:id="@+id/navigation_widget_compass"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="30dp"
        android:layout_marginEnd="30dp"
        android:src="@drawable/nav_compass_needle"
        android:visibility="gone"
        tools:visibility="visible" />

    <!-- Shown when no trip is running -->
    <LinearLayout
        android:id="@+id/navigation_widget_idle"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:alpha="0.4"
            android:src="@drawable/ic_navigation_white_24" />

        <TextView
            android:id="@+id/navigation_widget_idle_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:textColor="@color/colorGrey"
            android:textSize="14sp"
            tools:text="@string/navigation_idle" />

    </LinearLayout>

</FrameLayout>
