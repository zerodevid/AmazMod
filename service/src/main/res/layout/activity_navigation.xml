<?xml version="1.0" encoding="utf-8"?><!--
    Navigation screen for the round 360x360 Verge/Stratos display.
    Everything is centred and generously sized: this is read at a glance while riding.
-->
<android.support.wearable.view.BoxInsetLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/activity_navigation_main_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    tools:ignore="SpUsage, ContentDescription">

    <LinearLayout
        android:id="@+id/activity_navigation_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp">

        <!-- Manoeuvre arrow + distance until that manoeuvre -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/activity_navigation_icon"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginEnd="10dp"
                android:scaleType="fitCenter"
                android:visibility="gone"
                tools:src="@drawable/ic_navigation_white_24"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/activity_navigation_distance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/colorBlue"
                android:textSize="34sp"
                android:textStyle="bold"
                tools:text="450 m" />

        </LinearLayout>

        <!-- Road to turn into -->
        <TextView
            android:id="@+id/activity_navigation_road"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:textColor="@color/white"
            android:textSize="19sp"
            tools:text="Jl. Jenderal Sudirman" />

        <!-- Secondary instruction line, hidden when Maps does not provide one -->
        <TextView
            android:id="@+id/activity_navigation_road_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/colorGrey"
            android:textSize="13sp"
            android:visibility="gone"
            tools:text="towards Bundaran HI"
            tools:visibility="visible" />

        <!-- Trip summary: time left, distance left, arrival time -->
        <TextView
            android:id="@+id/activity_navigation_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/text"
            android:textSize="14sp"
            tools:text="23 min · 12 km · 20:45" />

        <!-- Shown instead of the instruction while Maps recalculates or the phone goes quiet -->
        <TextView
            android:id="@+id/activity_navigation_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/colorRed"
            android:textSize="13sp"
            android:visibility="gone"
            tools:text="@string/navigation_rerouting"
            tools:visibility="visible" />

    </LinearLayout>

</android.support.wearable.view.BoxInsetLayout>
