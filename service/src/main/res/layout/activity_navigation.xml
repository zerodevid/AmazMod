<?xml version="1.0" encoding="utf-8"?><!--
    Navigation screen for the round 360x360 Verge/Stratos display.

    Read at a glance while riding, so the next manoeuvre dominates and the trip figures sit in a
    labelled row underneath: each one is worth showing on its own rather than merged into a single
    line, because "how far to the turn", "how far left" and "how long left" answer different
    questions.
-->
<android.support.wearable.view.BoxInsetLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/activity_navigation_main_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    tools:ignore="SpUsage, ContentDescription">

    <LinearLayout
        android:id="@+id/activity_navigation_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="26dp"
        android:paddingEnd="26dp">

        <!-- Manoeuvre arrow + how far until that manoeuvre -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/activity_navigation_icon"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginEnd="10dp"
                android:scaleType="fitCenter"
                android:visibility="gone"
                tools:src="@drawable/ic_navigation_white_24"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/activity_navigation_distance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/colorBlue"
                android:textSize="36sp"
                android:textStyle="bold"
                tools:text="450 m" />

        </LinearLayout>

        <!-- Road to turn into -->
        <TextView
            android:id="@+id/activity_navigation_road"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:textColor="@color/white"
            android:textSize="18sp"
            tools:text="Jl. Jenderal Sudirman" />

        <!-- Secondary instruction line, hidden when Maps does not provide one -->
        <TextView
            android:id="@+id/activity_navigation_road_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/colorGrey"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="arah Bundaran HI"
            tools:visibility="visible" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="8dp"
            android:background="@color/colorGrey"
            android:alpha="0.35" />

        <!-- Trip figures, each labelled so none of them has to be guessed at -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/activity_navigation_remaining_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="12 km" />

                <TextView
                    android:id="@+id/activity_navigation_remaining_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textAllCaps="true"
                    android:textColor="@color/colorGrey"
                    android:textSize="10sp"
                    tools:text="@string/navigation_label_remaining" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/activity_navigation_duration_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="23 mnt" />

                <TextView
                    android:id="@+id/activity_navigation_duration_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textAllCaps="true"
                    android:textColor="@color/colorGrey"
                    android:textSize="10sp"
                    tools:text="@string/navigation_label_duration" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/activity_navigation_arrival_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="20.45" />

                <TextView
                    android:id="@+id/activity_navigation_arrival_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textAllCaps="true"
                    android:textColor="@color/colorGrey"
                    android:textSize="10sp"
                    tools:text="@string/navigation_label_arrival" />

            </LinearLayout>

        </LinearLayout>

        <!-- Shown instead of the instruction while Maps recalculates or the phone goes quiet -->
        <TextView
            android:id="@+id/activity_navigation_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/colorRed"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="@string/navigation_rerouting"
            tools:visibility="visible" />

    </LinearLayout>

</android.support.wearable.view.BoxInsetLayout>
