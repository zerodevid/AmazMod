<?xml version="1.0" encoding="utf-8"?><!--
    Navigation screen for the round 360x360 Verge/Stratos display.

    Read at a glance while riding, so the layout is a hierarchy rather than a list: the manoeuvre
    dominates the middle, the trip figures sit in a labelled row underneath, and the clock and
    route progress frame them without competing for attention.

    Height is the binding constraint: the panel is 360px at 240dpi, so there are only 240dp to
    work with. Everything below is sized to fit inside that with room to spare, because the content
    is centred and an overflow would clip the top and bottom rows rather than scroll.

    The background is pure black on purpose. The Verge panel is AMOLED, so black pixels cost no
    power, which matters when the screen is held on for a whole trip.
-->
<android.support.wearable.view.BoxInsetLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/activity_navigation_main_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    tools:ignore="SpUsage, ContentDescription">

    <LinearLayout
        android:id="@+id/activity_navigation_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp">

        <!--
            Wall clock, and the heart rate beside it when asked for. Small and dim: useful, never
            the thing you read first. Sharing this row means the heart rate costs no extra height on
            a screen that has little to spare.
        -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/activity_navigation_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:letterSpacing="0.08"
                android:maxLines="1"
                android:textColor="@color/colorGrey"
                android:textSize="13sp"
                tools:text="05:52" />

            <TextView
                android:id="@+id/activity_navigation_speed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="42 km/j"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/activity_navigation_heart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/colorRed"
                android:textSize="13sp"
                android:visibility="gone"
                tools:text="♥ 78"
                tools:visibility="visible" />

        </LinearLayout>

        <!-- Manoeuvre arrow on a disc + how far until that manoeuvre -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/activity_navigation_icon_holder"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/nav_icon_circle"
                android:visibility="gone"
                tools:visibility="visible">

                <!--
                    Compass and manoeuvre arrow share the disc because they never apply at once:
                    Maps names a direction only when it has no turn to give, and the arrow it sends
                    in that state is a generic "keep going" with nothing in it. Whichever is useful
                    gets the most prominent place on the screen.
                -->
                <ImageView
                    android:id="@+id/activity_navigation_compass"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:src="@drawable/nav_compass_needle"
                    android:visibility="gone"
                    tools:visibility="gone" />

                <ImageView
                    android:id="@+id/activity_navigation_icon"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:scaleType="fitCenter"
                    tools:src="@drawable/ic_navigation_white_24" />

            </FrameLayout>

            <TextView
                android:id="@+id/activity_navigation_distance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/colorBlue"
                android:textSize="33sp"
                android:textStyle="bold"
                tools:text="450 m" />

        </LinearLayout>

        <!-- Road to turn into -->
        <TextView
            android:id="@+id/activity_navigation_road"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:textColor="@color/white"
            android:textSize="18sp"
            tools:text="Jl. Jenderal Sudirman" />

        <!-- Secondary instruction line, hidden when Maps does not provide one -->
        <TextView
            android:id="@+id/activity_navigation_road_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/colorGrey"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="arah Bundaran HI"
            tools:visibility="visible" />

        <!-- The road ahead in Maps' own traffic colours, with a marker for where we are -->
        <com.amazmod.service.ui.RouteProgressView
            android:id="@+id/activity_navigation_progress"
            android:layout_width="match_parent"
            android:layout_height="7dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="8dp"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- Trip figures, each labelled so none of them has to be guessed at -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/activity_navigation_remaining_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="12 km" />

                <TextView
                    android:id="@+id/activity_navigation_remaining_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textAllCaps="true"
                    android:layout_marginTop="2dp"
                    android:letterSpacing="0.06"
                    android:textColor="@color/colorGrey"
                    android:textSize="9sp"
                    tools:text="@string/navigation_label_remaining" />

            </LinearLayout>

            <!-- Wider than its neighbours: durations run to "13j 19mnt" on a long route while the
                 arrival time never exceeds five characters -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.15"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/activity_navigation_duration_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="23 mnt" />

                <TextView
                    android:id="@+id/activity_navigation_duration_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textAllCaps="true"
                    android:layout_marginTop="2dp"
                    android:letterSpacing="0.06"
                    android:textColor="@color/colorGrey"
                    android:textSize="9sp"
                    tools:text="@string/navigation_label_duration" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.9"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/activity_navigation_arrival_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/colorGreen"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="20.45" />

                <TextView
                    android:id="@+id/activity_navigation_arrival_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textAllCaps="true"
                    android:layout_marginTop="2dp"
                    android:letterSpacing="0.06"
                    android:textColor="@color/colorGrey"
                    android:textSize="9sp"
                    tools:text="@string/navigation_label_arrival" />

            </LinearLayout>

        </LinearLayout>

        <!-- Shown instead of the instruction while Maps recalculates or the phone goes quiet -->
        <TextView
            android:id="@+id/activity_navigation_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/colorRed"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="@string/navigation_rerouting"
            tools:visibility="visible" />

    </LinearLayout>

</android.support.wearable.view.BoxInsetLayout>
